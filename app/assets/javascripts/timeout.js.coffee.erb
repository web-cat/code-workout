$ ->
	user_deadline_elem = $('#user-deadline')
	return unless user_deadline_elem.length && user_deadline_elem.data('deadline')

	deadline = moment.utc(user_deadline_elem.data('deadline'))
	server_now = moment.utc(user_deadline_elem.data('server-now'))
	client_now = moment.utc()
	offset = client_now.diff(server_now)
	one_second = 1000

	updateTimer = ->
		remaining = deadline.diff(moment.utc()) + offset
		duration = moment.duration(remaining, 'milliseconds')
		if duration > 0
			total_hours = Math.floor(duration.asHours())
			hours = if total_hours < 10 then '0' + total_hours else '' + total_hours
			minutes = ('0' + duration.minutes()).slice -2
			seconds = ('0' + duration.seconds()).slice -2
			$("#timer").html("Time remaining - " + hours + ":" + minutes + ":" + seconds)
		else
			clearInterval(window.workoutTimerInterval) if window.workoutTimerInterval
			$('#timer').html 'The time limit has passed. The assignment is closed and no longer accepting submissions.'
			$('.btn-submit').fadeOut 300, ->
				$(this).remove()

	updateTimer()
	clearInterval(window.workoutTimerInterval) if window.workoutTimerInterval
	window.workoutTimerInterval = setInterval updateTimer, one_second
