.container
  %h1 Select a Course Offering
  
  - if @course && @organization
    %p.lead
      Choose an existing offering for 
      = @course.display_name
      at
      = @organization.name
      to bind to your Canvas course.

  %p
    We found multiple potential course offerings in CodeWorkout that you manage. Please select the one that corresponds to your Canvas course, or create a new one.

  %table.table.table-striped
    %thead
      %tr
        %th Label
        %th Term
        %th Action
    %tbody
      - @course_offerings.each do |co|
        %tr
          %td= co.label
          %td= co.term.display_name
          %td
            - if @workout_name.present?
              = link_to 'Select', organization_find_workout_offering_path(organization_id: @organization.slug, course_id: @course.slug, term_id: @term.slug, workout_name: @workout_name, ext_lti_assignment_id: @ext_lti_assignment_id, custom_canvas_assignment_id: @custom_canvas_assignment_id, resource_link_id: @resource_link_id, from_collection: @from_collection, course_offering_id: co.id), class: 'btn btn-primary btn-sm'
            - else
              = link_to 'Select', '#', class: 'btn btn-primary btn-sm'

  %p.mt-4
    %strong Don't see your course offering?
    = link_to 'Create New Course Offering', new_organization_course_offering_path(organization_id: @organization.slug, course_id: @course.slug, term_id: @term.slug, workout_name: @workout_name, ext_lti_assignment_id: @ext_lti_assignment_id, custom_canvas_assignment_id: @custom_canvas_assignment_id, resource_link_id: @resource_link_id, from_collection: @from_collection), class: 'btn btn-success'
