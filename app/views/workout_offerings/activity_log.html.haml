%h1
  Activity Log for #{@student.display_name}
  %br
  %small on #{@workout_offering.workout.name}

- if @exercise
  %h2= @exercise.display_name

.row
  .col-md-12
    %table.table.table-striped.table-bordered.table-hover
      %thead
        %tr
          %th Time
          %th Event Type
          %th Activity
          %th IP Address
          %th Details
      %tbody
        - @events.each do |event|
          %tr
            %td= event[:time].strftime('%Y-%m-%d %H:%M:%S')
            %td
              %span.label{ class: event_type_label_class(event[:type]) }
                = event[:type].capitalize
            %td
              = event[:activity] == 'lti_launch' ? 'LTI launch' : event[:activity].humanize
              - if event[:lti]
                &nbsp;
                %span.badge LTI
            %td
              = event[:ip]
              - if event[:user_agent].present?
                %br
                %small= truncate(event[:user_agent].to_s, length: 60)
            %td
              - if event[:type] == 'attempt'
                Score: #{event[:score]}
                - ex = @exercise || (event[:details].respond_to?(:exercise_version) && event[:details].exercise_version.andand.exercise) || (event[:details].respond_to?(:exercise) && event[:details].exercise)
                - if ex
                  &nbsp;
                  = link_to 'View', organization_workout_offering_exercise_review_path(workout_offering_id: @workout_offering.id, review_user_id: @student.id, id: ex.id, attempt_id: event[:details].id, organization_id: @course_offering.course.organization.slug, course_id: @course_offering.course.slug, term_id: @course_offering.term.slug), class: 'btn btn-default btn-xs'
                - if event[:details].respond_to?(:prompt_answers)
                  - event[:details].prompt_answers.each do |prompt_answer|
                    - specific = prompt_answer.respond_to?(:specific) && prompt_answer.specific.present? ? prompt_answer.specific : prompt_answer
                    - if specific.is_a?(CodingPromptAnswer) || specific.is_a?(ParsonsPromptAnswer) || (specific.respond_to?(:answer) && !specific.respond_to?(:choices))
                      %pre= specific.answer
                    - elsif specific.is_a?(MultipleChoicePromptAnswer) || specific.respond_to?(:choices)
                      %div= mc_answer_display(prompt_answer)
              - elsif event[:type] == 'activity' && event[:activity] == 'practice_view'
                Viewed practice page
              - elsif event[:type] == 'activity' && event[:activity] == 'workout_view'
                Viewed workout show page
              - elsif event[:type] == 'activity' && event[:activity] == 'lti_launch'
                Successful LTI launch
              - elsif event[:type] == 'activity' && event[:activity] == 'workout_view_ip_blocked'
                %span.text-danger Blocked viewing workout (network location not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'practice_view_ip_blocked'
                %span.text-danger Blocked practice access (network location not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'attempt_ip_blocked'
                %span.text-danger Blocked attempt submission (network location not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'workout_view_user_agent_blocked'
                %span.text-danger Blocked viewing workout (browser agent not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'practice_view_user_agent_blocked'
                %span.text-danger Blocked practice access (browser agent not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'attempt_user_agent_blocked'
                %span.text-danger Blocked attempt submission (browser agent not permitted)
              - elsif event[:type] == 'visualization'
                Used code visualizer

= link_to 'Back to Review', organization_workout_offering_review_path(organization_id: @course_offering.course.organization.slug, course_id: @course_offering.course.slug, term_id: @course_offering.term.slug, id: @workout_offering.id, review_user_id: @student.id), class: 'btn btn-default'
