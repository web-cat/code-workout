%h1
  Activity Log for #{@student.display_name}
  %br
  %small on #{@workout_offering.workout.name}

- if @exercise
  %h2= @exercise.display_name

.row
  .col-md-12
    %table.table.table-striped.table-bordered.table-hover
      %thead
        %tr
          %th Time
          %th Event Type
          %th Activity
          %th IP Address
          %th Browser Agent
          %th LTI?
          %th Details
      %tbody
        - @events.each do |event|
          %tr
            %td= event[:time].strftime('%Y-%m-%d %H:%M:%S')
            %td
              %span.label{ class: event_type_label_class(event[:type]) }
                = event[:type].capitalize
            %td= event[:activity] == 'lti_launch' ? 'LTI launch' : event[:activity].humanize
            %td= event[:ip]
            %td
              - if event[:user_agent].present?
                %small= truncate(event[:user_agent], length: 60)
            %td
              - if event[:lti]
                %span.glyphicon.glyphicon-ok.text-success
              - else
                %span.glyphicon.glyphicon-remove.text-muted
            %td
              - if event[:type] == 'attempt'
                Score: #{event[:score]}
                - if @exercise
                  &nbsp;
                  = link_to 'View', organization_workout_offering_exercise_review_path(workout_offering_id: @workout_offering.id, review_user_id: @student.id, id: @exercise.id, attempt_id: event[:details].id, organization_id: @course_offering.course.organization.slug, course_id: @course_offering.course.slug, term_id: @course_offering.term.slug), class: 'btn btn-default btn-xs'
              - elsif event[:type] == 'activity' && event[:activity] == 'practice_view'
                Viewed practice page
              - elsif event[:type] == 'activity' && event[:activity] == 'workout_view'
                Viewed workout show page
              - elsif event[:type] == 'activity' && event[:activity] == 'lti_launch'
                Successful LTI launch
              - elsif event[:type] == 'activity' && event[:activity] == 'workout_view_ip_blocked'
                %span.text-danger Blocked viewing workout (network location not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'practice_view_ip_blocked'
                %span.text-danger Blocked practice access (network location not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'attempt_ip_blocked'
                %span.text-danger Blocked attempt submission (network location not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'workout_view_user_agent_blocked'
                %span.text-danger Blocked viewing workout (browser agent not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'practice_view_user_agent_blocked'
                %span.text-danger Blocked practice access (browser agent not permitted)
              - elsif event[:type] == 'activity' && event[:activity] == 'attempt_user_agent_blocked'
                %span.text-danger Blocked attempt submission (browser agent not permitted)
              - elsif event[:type] == 'visualization'
                Used code visualizer

= link_to 'Back to Review', workout_offering_review_path(id: @workout_offering.id, review_user_id: @student.id), class: 'btn btn-default'
