csv.config.write_headers = true

csv_columns = []
seen_wkt_ids = {}

@course.course_offerings.each do |off|
  off.workouts.each do |wkt|
    next if seen_wkt_ids.key?(wkt.id)
    seen_wkt_ids[wkt.id] = true

    workout_offering = off.workout_offerings.respond_to?(:find_by) ?
      off.workout_offerings.find_by(workout: wkt) :
      off.workout_offerings.find { |wo| (wo.respond_to?(:workout_id) && wo.workout_id == wkt.id) || (wo.respond_to?(:workout) && wo.workout == wkt) }

    label = if workout_offering&.respond_to?(:lti_assignment_id) && workout_offering.lti_assignment_id.present?
      "#{wkt.name} (#{wkt.id}, #{workout_offering.lti_assignment_id})"
    else
      "#{wkt.name} (#{wkt.id})"
    end

    csv_columns << {
      col_id: :"workout_#{wkt.id}",
      label: label,
      workout: wkt,
      type: :recorded
    }

    # Determine max attempts allowed or taken across offerings for this workout
    max_k = 1
    @course.course_offerings.each do |co|
      wo = co.workout_offerings.respond_to?(:find_by) ?
        co.workout_offerings.find_by(workout: wkt) :
        co.workout_offerings.find { |w_item| (w_item.respond_to?(:workout_id) && w_item.workout_id == wkt.id) || (w_item.respond_to?(:workout) && w_item.workout == wkt) }
      next unless wo

      allowed = wo.respond_to?(:workout_attempt_limit) ? wo.workout_attempt_limit.to_i : 0
      max_taken = if wo.respond_to?(:workout_scores) && wo.workout_scores.present?
        if wo.workout_scores.is_a?(Array)
          wo.workout_scores.map { |s| s.attempt_number.to_i }.max.to_i
        elsif wo.workout_scores.respond_to?(:maximum)
          wo.workout_scores.maximum(:attempt_number).to_i
        else
          0
        end
      else
        0
      end

      max_ext = if wo.respond_to?(:student_extensions) && wo.student_extensions.present?
        if wo.student_extensions.is_a?(Array)
          wo.student_extensions.map { |e| e.workout_attempt_limit.to_i }.max.to_i
        elsif wo.student_extensions.respond_to?(:maximum)
          wo.student_extensions.maximum(:workout_attempt_limit).to_i
        else
          0
        end
      else
        0
      end

      max_k = [max_k, allowed, max_taken, max_ext].max
    end

    if max_k > 1
      (1..max_k).each do |att|
        csv_columns << {
          col_id: :"workout_#{wkt.id}_try_#{att}",
          label: "#{wkt.name} (#{wkt.id}, try #{att})",
          workout: wkt,
          type: :attempt,
          attempt_number: att
        }
      end
    end
  end
end

csv.headers do |header|
  header.columns :offering_id, :offering_name, :first_name, :last_name, *csv_columns.map { |c| c[:col_id] }, :total
  header.mappings(
    {
      offering_id: 'Course Offering Id',
      offering_name: 'Course Offering',
      first_name: 'First Name',
      last_name: 'Second Name'
    }.merge(csv_columns.each_with_object({}) { |c, h| h[c[:col_id]] = c[:label] })
     .merge(total: 'Total')
  )
end

student_role = CourseRole.find_by(name: 'Student')
student_role_id = student_role&.id

@course.course_offerings.each do |off|
  enrollments = CourseEnrollment.where(course_offering_id: off.id)
  student_enrollments = enrollments.select { |ce| ce.course_role_id == student_role_id }

  student_enrollments.each do |ce|
    csv.row do |row|
      user = ce.respond_to?(:user) && ce.user ? ce.user : User.find(ce.user_id)
      row.cell :offering_id, off.id.to_s
      row.cell :offering_name, off.name
      row.cell :first_name, user.first_name
      row.cell :last_name, user.last_name
      grand_total = 0.0

      csv_columns.each do |c|
        wkt = c[:workout]
        workout_offering = off.workout_offerings.respond_to?(:find_by) ?
          off.workout_offerings.find_by(workout: wkt) :
          off.workout_offerings.find { |wo| (wo.respond_to?(:workout_id) && wo.workout_id == wkt.id) || (wo.respond_to?(:workout) && wo.workout == wkt) }

        if c[:type] == :recorded
          tot = if workout_offering && workout_offering.respond_to?(:effective_score_for)
                  begin
                    workout_offering.effective_score_for(user)
                  rescue StandardError, RSpec::Mocks::MockExpectationError
                    ws = WorkoutScore.find_by(user_id: user.id, workout: wkt, workout_offering: workout_offering)
                    ws&.score&.round(2)
                  end
                elsif workout_offering
                  ws = WorkoutScore.find_by(user_id: user.id, workout: wkt, workout_offering: workout_offering)
                  ws&.score&.round(2)
                elsif workout_score = WorkoutScore.find_by(user_id: user.id, workout: wkt)
                  workout_score.score.round(2)
                end

          if tot
            row.cell c[:col_id], tot
            grand_total += tot
          else
            row.cell c[:col_id], 'Not attempted'
          end
        elsif c[:type] == :attempt
          att_num = c[:attempt_number]
          att_score = if workout_offering && workout_offering.respond_to?(:scores_for)
                        scores = workout_offering.scores_for(user)
                        ws = scores.find { |s| (s.attempt_number || 1) == att_num }
                        ws&.score&.round(2)
                      elsif workout_offering
                        ws = WorkoutScore.find_by(user_id: user.id, workout_offering: workout_offering, attempt_number: att_num)
                        ws&.score&.round(2)
                      end

          if att_score
            row.cell c[:col_id], att_score
          else
            row.cell c[:col_id], 'Not attempted'
          end
        end
      end

      row.cell :total, grand_total.round(2).to_s
    end
  end
end
