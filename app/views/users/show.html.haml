%p#notice= notice

= image_tag @user.avatar_url, alt: ''

%p
  %strong First name:
  = @user.first_name

%p
  %strong Last name:
  = @user.last_name

%p
  %strong Timezone:
  = @user.time_zone

%p
  %strong Email:
  = link_to @user.email, 'mailto:' + @user.email
%br
- if @user.workout_scores.size > 0
  %table.table.table-striped
    %thead
      %tr
        %th Workout name
        %th Score
        - if current_user.andand.global_role.andand.is_admin?
          %th.text-right Actions
    %tbody
      - @workout_scores.each do |user_score|
        %tr
          %td= user_score.workout.name
          - score = user_score.andand.score
          - if score && user_score.show_score?
            %td= score
          - else
            %td.textblur -/-
          - if current_user.andand.global_role.andand.is_admin?
            %td.text-right
              = link_to 'View Log', activity_log_path(user_score), class: 'btn btn-xs btn-info'

%br

- if can? :update, @user
  = button_link 'Edit', edit_user_path(@user)
