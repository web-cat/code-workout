- course_offering ||= @workout_offering.andand.course_offering
- workout_score ||= @workout_score || (@workout_offering ? (@active_score || @workout_offering.kept_workout_score_for(current_user) || @workout_offering.latest_score_for(current_user)) : @workout.score_for(current_user, @workout_offering))
- can_view_as_student = @can_view_as_student.nil? ? (current_user.andand.global_role.andand.is_admin? || course_offering.andand.is_staff?(current_user)) : @can_view_as_student
- as_student = can_view_as_student && (defined?(@as_student) ? @as_student : params[:student].to_b)
- is_staff = as_student ? false : (@is_staff.nil? ? (course_offering && course_offering.is_staff?(current_user)) : @is_staff)
- is_admin = current_user ? current_user.global_role.is_admin? : false
- manages_course = as_student ? false : (@manages_course.nil? ? (current_user ? (is_admin || course_offering.andand.is_manager?(current_user)) : false) : @manages_course)
- past_scores = @past_scores || (@workout_offering ? @workout_offering.scores_for(current_user) : [])
- active_score = @active_score || (@workout_offering ? @workout_offering.active_score_for(current_user) : nil)
- can_retake = @can_retake.nil? ? (@workout_offering ? @workout_offering.can_start_new_attempt?(current_user) : false) : @can_retake
- allowed_att = @workout_offering ? @workout_offering.attempts_allowed_for(current_user) : 1
- multiple_allowed = @workout_offering ? (allowed_att.nil? || allowed_att > 1 || allowed_att == 0) : false
- last_closed_score = past_scores.present? ? past_scores.select { |s| s.try(:closed?) || s.try(:completed?) }.last : nil
- finished_score = last_closed_score || workout_score
- is_finished = finished_score && (finished_score.try(:closed?) || finished_score.try(:completed?)) && (active_score.nil? || active_score.try(:closed?) || active_score.try(:completed?))
- finished_at = finished_score ? (finished_score.try(:completed_at) || finished_score.try(:updated_at)) : nil
= render partial: 'layouts/breadcrumb'
- time_limit = (@workout_offering ? @workout_offering.time_limit_for(current_user) : nil)

- if can_view_as_student
  .pull-right{ style: 'margin-top: 5px;' }
    - if as_student
      = link_to url_for(request.query_parameters.except('student')), class: 'btn btn-default btn-sm', title: 'Exit student view' do
        %i.fa.fa-user
        Exit Student View
    - else
      = link_to url_for(request.query_parameters.merge(student: true)), class: 'btn btn-default btn-sm', title: 'Preview as student' do
        %i.fa.fa-user-secret
        Student View

= render partial: 'workout_scores/time_remaining',
  locals: { workout_score: workout_score }


%h1= @workout.name

- if @workout.tags.any?
  %p
    Tags:
    - @workout.tags.each do |t|
      =link_to t.name, exercises_search_path(search: t.name), class: 'tag'

- if is_staff
  %table.table.table-striped{ style: 'width: auto' }
    %thead
      %tr
        %th Course
        %th From
        %th Due
        %th Until
        %th Time Limit
    %tbody
      - @workout.workout_offerings.each do |woff|
        %tr
          %td= woff.course_offering.display_name
          %td
            - if woff.opening_date
              = l user_time(current_user, woff.opening_date)
          %td
            - if woff.soft_deadline
              = l user_time(current_user, woff.soft_deadline)
          %td
            - if woff.hard_deadline
              = l user_time(current_user, woff.hard_deadline)
          %td
            - if time_limit
              = "#{n_to_s(time_limit)} minutes"
- elsif @workout_offering
  %p.due
    - if @workout_offering.soft_deadline
      Due:
      = l user_time(current_user, @workout_offering.soft_deadline)
    - elsif @workout_offering.hard_deadline
      Until:
      = l user_time(current_user, @workout_offering.hard_deadline)
    - if is_finished && finished_at
      &nbsp;&nbsp;&nbsp;Finished:
      = l user_time(current_user, finished_at)
    - if time_limit
      &nbsp;&nbsp;&nbsp;Time Limit:
      = "#{n_to_s(time_limit)} minutes"
    - if multiple_allowed
      &nbsp;&nbsp;&nbsp;Allowed Attempts:
      = (allowed_att.nil? || allowed_att <= 0) ? 'Unlimited' : allowed_att
      &nbsp;&nbsp;&nbsp;Scoring:
      = @workout_offering.score_to_keep == 'latest' ? 'Latest attempt' : 'Highest attempt'
      &nbsp;&nbsp;&nbsp;Recorded Score:
      - if workout_score
        - if workout_score.show_score?
          = @workout_offering.effective_score_for(current_user)
        - else
          hidden
      - else
        0
      = '/'
      = @workout.total_points
    - else
      &nbsp;&nbsp;&nbsp;Score:
      - if workout_score
        - if workout_score.show_score?
          = workout_score.score
        - else
          hidden
      - else
        0
      = '/'
      = @workout.total_points
-else
  %p.due
    = "Score: " + (workout_score ? workout_score.score.to_s  : "0") + " / " + @workout.total_points.to_s

- if @workout.description
  %p= markdown(@workout.description)

.col-md-6
  .btn-group
    - if @workout_offering
      - if active_score && !active_score.closed?
        - continue_text = multiple_allowed ? "Continue Workout (Attempt #{active_score.attempt_number})" : "Continue Workout"
        = link_to continue_text,                                             |
          organization_workout_offering_practice_path(organization_id:        |
          @workout_offering.course_offering.course.organization.slug,         |
          course_id: @workout_offering.course_offering.course.slug,           |
          term_id: @workout_offering.course_offering.term.slug,               |
          id: @workout_offering.id,                                          |
          workout_score_id: active_score.id),                                |
          class: 'btn btn-primary'
      - elsif can_retake && (past_scores.blank? || past_scores.empty?)
        = link_to 'Start Workout',                                          |
          organization_workout_offering_practice_path(organization_id:      |
          @workout_offering.course_offering.course.organization.slug,       |
          course_id: @workout_offering.course_offering.course.slug,         |
          term_id: @workout_offering.course_offering.term.slug,             |
          id: @workout_offering.id),                                        |
          class: 'btn btn-primary'
      - elsif can_retake && multiple_allowed
        = button_to "Take Workout Again (Attempt #{past_scores.size + 1})", |
          start_attempt_workout_offering_path(@workout_offering),           |
          method: :post,                                                    |
          class: 'btn btn-primary'
      - elsif manages_course || (@workout_offering.can_be_seen_by?(current_user) && !@workout_offering.andand.workout_policy.andand.no_review_before_close)
        - review_score = @workout_offering.kept_workout_score_for(current_user) || @workout_offering.latest_score_for(current_user)
        = link_to 'Review Workout',                                           |
          organization_workout_offering_review_path(organization_id:         |
          @workout_offering.course_offering.course.organization.slug,        |
          course_id: @workout_offering.course_offering.course.slug,          |
          term_id: @workout_offering.course_offering.term.slug,              |
          id: @workout_offering.id,                                          |
          review_user_id: current_user.id,                                   |
          workout_score_id: review_score.andand.id),                          |
          class: 'btn btn-primary'
      - elsif !manages_course && @workout_offering.andand.workout_policy.andand.no_review_before_close
        %p
          You can review your work on this workout once everyone has completed it.
    - else
      = link_to 'Start Workout', practice_workout_path(params[:id]), |
        class: 'btn btn-primary'
    - if !as_student && (manages_course || (current_user && (current_user == @workout.creator || @workout.owners.exists?(current_user.id))))
      - if @workout_offering
        = link_to 'Edit Workout',
          organization_edit_workout_path(organization_id: @organization.slug,
            course_id: @course.slug,
            term_id: @term.slug,
            workout_offering_id: @workout_offering.id),
          class: 'btn btn-default'
      - else
        = link_to 'Edit Workout',
          edit_workout_path(id: @workout.id),
          class: 'btn btn-default'
%br
%br

- if @workout_offering && past_scores.present? && (is_staff || (multiple_allowed && past_scores.any? { |s| s.closed? || s.completed? }))
  = render partial: 'workouts/attempt_history',
    locals: { scores: past_scores,
      workout: @workout,
      workout_offering: @workout_offering,
      course_offering: course_offering,
      review_user: current_user,
      current_score: nil,
      is_staff: is_staff,
      is_admin: is_admin,
      manages_course: manages_course }
%br

%h2 Exercises

- if !manages_course && workout_score.nil? && @workout_offering.andand.workout_policy.andand.hide_thumbnails_before_start
  .alert.alert-warning You must begin this workout before you can see its exercises.
- elsif !manages_course && workout_score.andand.closed? && !@workout_offering.andand.shutdown? && (@workout_offering.andand.workout_policy.andand.no_review_before_close || @workout_offering.andand.workout_policy.andand.hide_thumbnails_in_review_before_close)
  .alert.alert-warning Results will be visible after the assignment closes.
- elsif is_staff && !as_student && @workout.exercise_pools.any?
  .workout-pools
    - @workout.exercise_pools.order(:position).each do |pool|
      .panel.panel-default.workout-pool-panel{ style: 'margin-bottom: 20px;' }
        .panel-heading
          %h4.panel-title
            %strong= "Slot #{pool.position}:"
            - if pool.exercise_pool_items.count > 1
              %span.label.label-info= "Pool (Draw #{pool.select_count} of #{pool.exercise_pool_items.count})"
            - else
              %span.label.label-default Single Exercise
            %span.pull-right.text-muted
              = "#{pool.points} pts each (#{pool.total_points} pts slot total)"
        .panel-body
          - pool_exs = pool.exercise_pool_items.order(:position).includes(exercise: [{ current_version: :prompts }, :tags, :languages, :styles, :exercise_collection, :exercise_owners]).map(&:exercise)
          - pool_exs.in_groups_of(2, false) do |row|
            = render row,
              user: current_user,
              workout_offering: @workout_offering,
              workout_score: nil,
              workout: @workout,
              manages_course: manages_course,
              start_workout: false,
              review: false
            .clearfix
- elsif @exs.empty?
  .alert.alert-warning No exercises in this workout
- else
  - user = current_user
  - @exs.in_groups_of(2, false) do |row|
    = render row,
      user: user,
      workout_offering: @workout_offering,
      workout_score: workout_score,
      workout: @workout,
      manages_course: manages_course,
      start_workout: true,
      review: false
    .clearfix
