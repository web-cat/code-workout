- course_offering ||= @workout_offering.andand.course_offering
- review_user = params[:review_user_id].present? ? User.find_by(id: params[:review_user_id]) : current_user
- review_user ||= current_user
- all_scores = @all_scores || (@workout_offering ? @workout_offering.scores_for(review_user) : [])
- workout_score ||= @workout_score || (params[:workout_score_id].present? ? all_scores.find { |s| s.id.to_s == params[:workout_score_id].to_s } : nil)
- workout_score ||= @workout_offering ? (@workout_offering.kept_workout_score_for(review_user) || @workout_offering.latest_score_for(review_user)) : @workout.score_for(review_user, @workout_offering)
- kept_score = @workout_offering ? @workout_offering.kept_workout_score_for(review_user) : nil
= render partial: 'layouts/breadcrumb'

%h1= @workout.name

- if @workout.tags.any?
  %p
    Tags:
    - @workout.tags.each do |t|
      =link_to t.name, exercises_search_path(search: t.name), class: 'tag'

- if all_scores && all_scores.size > 1 && course_offering
  %div{ style: 'margin-bottom: 20px;' }
    %strong Attempts:
    %ul.nav.nav-pills{ style: 'margin-top: 5px;' }
      - all_scores.each do |score|
        - is_active = (workout_score && workout_score.id == score.id)
        - is_kept = (kept_score && kept_score.id == score.id)
        %li{ class: ('active' if is_active) }
          = link_to organization_workout_offering_review_path(organization_id: course_offering.course.organization.slug, course_id: course_offering.course.slug, term_id: course_offering.term.slug, id: @workout_offering.id, review_user_id: review_user.id, workout_score_id: score.id) do
            = "Attempt #{score.attempt_number}"
            - if is_kept
              %span.badge{ style: 'background-color: #5cb85c; margin-left: 4px;' } Kept

- if course_offering && course_offering.is_staff?(review_user)
  %table.table.table-striped{ style: 'width: auto' }
    %thead
      %tr
        %th Course
        %th From
        %th Due
        %th Until
        %th Time Limit
    %tbody
      - @workout.workout_offerings.each do |woff|
        %tr
          %td= woff.course_offering.display_name
          %td
            - if woff.opening_date
              = l user_time(current_user, woff.opening_date)
          %td= l user_time(current_user, woff.soft_deadline)
          %td= l user_time(current_user, woff.hard_deadline)
- elsif @workout_offering
  %p
    - if review_user.id != current_user.id
      Student:
      = "#{review_user.display_name}."
    - if workout_score
      &nbsp;&nbsp;&nbsp;Viewing Attempt:
      %strong= "#{workout_score.attempt_number}"
      - allowed = @workout_offering.attempts_allowed_for(review_user)
      = "of #{allowed && allowed > 0 ? allowed : 'Unlimited'}"
      - if kept_score && kept_score.id == workout_score.id
        %span.label.label-success{ style: 'margin-left: 5px;' } Kept Score
      &nbsp;&nbsp;&nbsp;Scoring Policy:
      = @workout_offering.score_to_keep == 'latest' ? 'Latest attempt' : 'Highest attempt'
    - if workout_score.andand.last_attempted_at
      &nbsp;&nbsp;&nbsp;Last Attempted:
      = l user_time(current_user, workout_score.last_attempted_at)
    - elsif @workout_offering.hard_deadline
      Due:
      = l user_time(current_user, @workout_offering.hard_deadline)
    &nbsp;&nbsp;&nbsp;Score:
    - if workout_score
      - if workout_score.show_score? || (review_user && course_offering.andand.is_staff?(review_user))
        = workout_score.score
      - else
        hidden
    - else
      0
    = '/'
    = @workout.total_points
    - if current_user.global_role.is_admin? || course_offering.andand.is_staff?(current_user)
      - if workout_score
        &nbsp;&nbsp;&nbsp;
        = link_to 'View Activity Log', organization_workout_offering_activity_log_path(id: @workout_offering.id, workout_score_id: workout_score.id, organization_id: course_offering.course.organization.slug, course_id: course_offering.course.slug, term_id: course_offering.term.slug), class: 'btn btn-info btn-sm'
-else
  %p.due
    Score: 0 /
    = @workout.total_points

-# score_pct = wscore ? (wscore.score/workout.total_points * 100).round(0) : 0
-# if score_pct == 100 && wscore.score < workout.total_points
-#  - score_pct = 99

- if @workout.description
  %p= markdown(@workout.description)


%h2 Exercises

- manages_course = current_user.global_role.is_admin? || course_offering.andand.is_manager?(current_user)

- if !manages_course && workout_score.nil? && @workout_offering.andand.workout_policy.andand.hide_thumbnails_before_start
  .alert.alert-warning You must begin this workout before you can see its exercises.
- elsif !manages_course && workout_score.andand.closed? && !@workout_offering.andand.shutdown? && (@workout_offering.andand.workout_policy.andand.no_review_before_close || @workout_offering.andand.workout_policy.andand.hide_thumbnails_in_review_before_close)
  .alert.alert-warning Results will be visible after the assignment closes.
- elsif @exs.empty?
  .alert.alert-warning No exercises in this workout
- else
  - user = review_user
  - @exs.in_groups_of(2, false) do |row|
    = render row,
      user: user,
      workout_offering: @workout_offering,
      workout_score: workout_score,
      workout: @workout,
      start_workout: false,
      review: true
    .clearfix
