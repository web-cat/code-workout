- course_offering ||= @workout_offering.andand.course_offering
- review_user = params[:review_user_id].present? ? User.find_by(id: params[:review_user_id]) : current_user
- review_user ||= current_user
- all_scores = @all_scores || (@workout_offering ? @workout_offering.scores_for(review_user) : [])
- workout_score ||= @workout_score || (params[:workout_score_id].present? ? all_scores.find { |s| s.id.to_s == params[:workout_score_id].to_s } : nil)
- workout_score ||= @workout_offering ? (@workout_offering.kept_workout_score_for(review_user) || @workout_offering.latest_score_for(review_user)) : @workout.score_for(review_user, @workout_offering)
- kept_score = @workout_offering ? @workout_offering.kept_workout_score_for(review_user) : nil
- is_admin = current_user ? current_user.global_role.is_admin? : false
- is_staff = is_admin || (course_offering && course_offering.is_staff?(current_user))
- manages_course = is_admin || (course_offering && course_offering.is_manager?(current_user))
= render partial: 'layouts/breadcrumb'

%h1= @workout.name

- if @workout.tags.any?
  %p
    Tags:
    - @workout.tags.each do |t|
      =link_to t.name, exercises_search_path(search: t.name), class: 'tag'

- if @workout_offering
  %p
    - if review_user.id != current_user.id
      = (course_offering && course_offering.is_staff?(review_user)) ? 'User:' : 'Student:'
      = review_user.display_name
      - if !is_staff || !all_scores.present?
        - if workout_score
          - allowed = @workout_offering.attempts_allowed_for(review_user)
          - multiple_allowed = allowed.nil? || allowed > 1 || allowed == 0
          - if multiple_allowed && all_scores && all_scores.size > 1
            &nbsp;&nbsp;&nbsp;Viewing Attempt:
            %strong= "#{workout_score.attempt_number}"
            = "of #{allowed && allowed > 0 ? allowed : 'Unlimited'}"
            - if kept_score && kept_score.id == workout_score.id
              %span.label.label-success{ style: 'margin-left: 5px;' } Score
            &nbsp;&nbsp;&nbsp;Scoring Policy:
            = @workout_offering.workout_score_to_keep == 'latest' ? 'Latest attempt' : 'Highest attempt'
        - if workout_score.andand.last_attempted_at
          &nbsp;&nbsp;&nbsp;Last Attempted:
          = l user_time(current_user, workout_score.last_attempted_at)
        - elsif @workout_offering.hard_deadline
          Due:
          = l user_time(current_user, @workout_offering.hard_deadline)
        &nbsp;&nbsp;&nbsp;Score:
        - if workout_score
          - if workout_score.show_score? || is_staff || (review_user && course_offering.andand.is_staff?(review_user))
            = workout_score.score
          - else
          hidden
        - else
          0
        = '/'
        = @workout.total_points
- else
  %p.due
    Score: 0 /
    = @workout.total_points

-# score_pct = wscore ? (wscore.score/workout.total_points * 100).round(0) : 0
-# if score_pct == 100 && wscore.score < workout.total_points
-#  - score_pct = 99

- if @workout_offering && (all_scores.present? || is_staff)
  = render partial: 'workouts/attempt_history',
    locals: { scores: all_scores,
      workout: @workout,
      workout_offering: @workout_offering,
      course_offering: course_offering,
      review_user: review_user,
      current_score: workout_score,
      is_staff: is_staff,
      is_admin: is_admin,
      manages_course: manages_course }

%h2 Exercises

- if !manages_course && workout_score.nil? && @workout_offering.andand.workout_policy.andand.hide_thumbnails_before_start
  .alert.alert-warning You must begin this workout before you can see its exercises.
- elsif !manages_course && workout_score.andand.closed? && !@workout_offering.andand.shutdown? && (@workout_offering.andand.workout_policy.andand.no_review_before_close || @workout_offering.andand.workout_policy.andand.hide_thumbnails_in_review_before_close)
  .alert.alert-warning Results will be visible after the assignment closes.
- elsif @exs.empty?
  .alert.alert-warning No exercises in this workout
- else
  - user = review_user
  - @exs.in_groups_of(2, false) do |row|
    = render row,
      user: user,
      workout_offering: @workout_offering,
      workout_score: workout_score,
      workout: @workout,
      start_workout: false,
      review: true
    .clearfix
